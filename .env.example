# Autenticação do painel /admin (obrigatório para conseguir logar)
# Gere um valor aleatório longo para ADMIN_SESSION_SECRET, ex.: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Publicação de posts via GitHub (opcional).
# Sem isso, criar/editar/excluir posts pelo admin só grava localmente
# (funciona em `npm run dev`, mas não persiste em produção serverless).
# Use um Personal Access Token com escopo restrito a este repositório
# (Contents: Read and write).
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# SEO
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
GOOGLE_SITE_VERIFICATION=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
